# ==============================================================================
# VersionRAG Enterprise Platform — Environment Configuration Template
# ==============================================================================
# Copy this file to `.env` in the project root to customize local or production settings.

# ------------------------------------------------------------------------------
# 1. Platform & Application Server
# ------------------------------------------------------------------------------
PROJECT_NAME="VersionRAG"
HOST="127.0.0.1"
PORT=8001
SECRET_KEY="replace-with-a-cryptographically-secure-random-secret-key-32-chars-min"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# ------------------------------------------------------------------------------
# 2. Database & Vector Storage
# ------------------------------------------------------------------------------
# SQLite (zero-setup default):
DATABASE_URL="sqlite:///./versionrag.db"
# PostgreSQL with pgvector (production HNSW index):
# DATABASE_URL="postgresql://user:password@localhost:5432/versionrag"
SQL_DEBUG=false

# ------------------------------------------------------------------------------
# 3. Redis Caching & Distributed Rate Limiting (Optional)
# ------------------------------------------------------------------------------
# If left commented or unavailable, VersionRAG automatically falls back to
# thread-safe in-memory sliding-window rate limiting with zero downtime.
# REDIS_URL="redis://localhost:6379/0"

# ------------------------------------------------------------------------------
# 4. Email & Two-Factor OTP Verification
# ------------------------------------------------------------------------------
# Set OTP_ENABLED=false for instant 1-click accounts without email confirmation.
OTP_ENABLED=false
OTP_EXPIRE_MINUTES=15
OTP_LENGTH=6

# Gmail SMTP Configuration (Required only if OTP_ENABLED=true):
# 1. Enable 2-Step Verification at https://myaccount.google.com/security
# 2. Generate an App Password at https://myaccount.google.com/apppasswords
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-16-char-app-password"
EMAILS_FROM_NAME="VersionRAG Platform"
EMAILS_FROM_EMAIL="your-email@gmail.com"

# ------------------------------------------------------------------------------
# 5. External AI Providers (Optional BYOK Gateway)
# ------------------------------------------------------------------------------
# If omitted, VersionRAG uses its built-in Deterministic Neural Synthesizer.
# OPENAI_API_KEY="sk-proj-..."
# GEMINI_API_KEY="AIzaSy..."
# GROQ_API_KEY="gsk_..."
# ANTHROPIC_API_KEY="sk-ant-..."
DEFAULT_EMBEDDING_MODEL="text-embedding-3-small"
DEFAULT_LLM_MODEL="gpt-4o-mini"
USE_MOCK_AI_IF_NO_KEY=true

# ------------------------------------------------------------------------------
# 6. Storage & Upload Policies
# ------------------------------------------------------------------------------
MAX_UPLOAD_SIZE_MB=50
